# OpenCode Docker Configuration

# OpenRouter API Key (for using OpenRouter as model provider)
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Specify OpenRouter model (defaults to minimax/minimax-m2.1)
# Examples: minimax/minimax-m2.1, anthropic/claude-3.5-sonnet, anthropic/claude-3-opus, openai/gpt-4-turbo
# OPENROUTER_MODEL=minimax/minimax-m2.1

# Alternative: Direct OpenCode API Key (if not using OpenRouter)
# Get your API key from https://opencode.ai
# OPENCODE_API_KEY=your_opencode_api_key_here

# User and Group IDs (defaults to current user)
USER_UID=1000
USER_GID=1000

# Timezone
TZ=UTC

# Optional: Docker resource limits
# DOCKER_MEMORY_LIMIT=8g
# DOCKER_GPU_ACCESS=all

# Optional: Additional system packages to install in the container
# Space-separated list of apt packages
# SYSTEM_PACKAGES="vim curl htop neovim"